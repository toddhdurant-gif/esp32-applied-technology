# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is gitignored - your credentials never leave your machine.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# 32-byte base64 key for the ESPHome native API.
# Generate one: https://esphome.io/components/api.html (or `openssl rand -base64 32`)
wp47d2_api_key: "GENERATE_YOUR_OWN_32_BYTE_BASE64_KEY"

wp47d2_ota_password: "CHOOSE_AN_OTA_PASSWORD"

# Home Assistant long-lived access token, WITH the "Bearer " prefix.
# HA profile -> Security -> Long-lived access tokens.
ha_token_bearer: "Bearer YOUR_LONG_LIVED_HA_TOKEN"
